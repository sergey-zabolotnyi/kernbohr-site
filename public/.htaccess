# 301-Weiterleitungen für Apache-Hosting (IONOS, Strato, All-Inkl u. a.)
# ACHTUNG: Diese Datei ersetzt auf dem Server eine vorhandene .htaccess (z. B. von WordPress). Vorher sichern!
# HTTP -> HTTPS und www -> ohne www (301, Pfad bleibt erhalten: $1)
# Falls nach dem Hochladen eine Endlosschleife entsteht: Datei sofort durch die gesicherte Version ersetzen.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://kernbohr-expert.de/$1 [R=301,L]

# Alte WordPress-Adressen
RedirectMatch 301 ^/contact/?$ /kontakt/
RedirectMatch 301 ^/about/?$ /ueber-uns/
RedirectMatch 301 ^/services/?$ /leistungen/
RedirectMatch 301 ^/projects/?$ /referenzen/
RedirectMatch 301 ^/beratung/?$ /kontakt/
RedirectMatch 301 ^/hallo-welt/?$ /

# Zeichensatz: Textdateien (llms.txt, robots.txt, JSON, XML) immer als UTF-8 ausliefern
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .json .xml .html

# Browser-Cache für statische Dateien (Bilder, Videos, Skripte, Schriften)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

# Sicherheits-Header (nur wenn mod_headers aktiv ist, sonst wird der Block ignoriert)
# HSTS bewusst mit kurzer Laufzeit (5 Minuten); nach erfolgreichem Test auf 31536000 (1 Jahr) erhöhen.
# Content-Security-Policy folgt später zuerst im Report-Only-Modus, weil eine strenge Policy Chat/Skripte brechen kann.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=300"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Eigene 404-Seite
ErrorDocument 404 /404.html
