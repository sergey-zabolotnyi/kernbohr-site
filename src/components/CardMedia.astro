---
// Foto oben auf einer Karte: Foto aus dem Manifest, sonst Video-Poster.
import { image } from '../lib/media.js';
const { id, alt = '' } = Astro.props;
const m = image(id);
---
{m ? (
  <img class="card-img" src={`/images/${id}-800.webp`} srcset={`/images/${id}-800.webp 800w, /images/${id}-1600.webp 1600w`} sizes="(max-width: 700px) 100vw, 360px" width={m.w} height={m.h} alt={m.alt} loading="lazy" decoding="async" />
) : (
  <img class="card-img" src={`/posters/${id}.jpg`} width="720" height="1280" alt={alt} loading="lazy" decoding="async" />
)}
