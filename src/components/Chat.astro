        priceIntro: 'Здесь можно рассчитать ориентировочную цену и скачать её в виде PDF-предложения.', priceTitle: 'Рассчитать цену', dia: 'Диаметр (мм)', depth: 'Глубина (см)', count: 'Количество', material: 'Материал', beton: 'Бетон / железобетон', mauer: 'Кладка',
        priceNote: 'Ориентир, не является обязательством, брутто, включая выезд и пилотное отверстие.', pdf: 'Скачать PDF-предложение', pdfBusy: 'Создаётся PDF …', pdfFail: 'PDF недоступен, запросите через WhatsApp.',
        err: 'Помощник сейчас недоступен. Позвоните нам: +49 177 190 90 49 (пн–сб 7–19) или напишите в WhatsApp.',
      },
      it: {
        ph: 'La sua domanda …', greet: 'Buongiorno, sono Kerni, l\'assistente digitale di Kernbohr-Expert. Rispondo a domande su carotaggi, prezzi e svolgimento dei lavori. Come posso aiutarla?',
        chipPreis: 'Calcola il prezzo', chipAnfrage: 'Invia richiesta online', chipWa: 'WhatsApp con riepilogo',
        formIntro: 'Volentieri! Completi i dati qui sotto, li controlli e invii la richiesta.',
        formTitle: 'La sua richiesta al sig. Salcutan', name: 'Nome', phone: 'Numero di telefono', place: 'Luogo del cantiere', concern: 'La sua richiesta',
        photos: 'Foto del cantiere (facoltative, fino a 3)', addPhoto: '+ Aggiungi foto',
        consent: 'Acconsento che Kernbohr-Expert riceva questi dati (ed eventuali foto) per elaborare la mia richiesta e contattarmi. L\'inoltro avviene via e-mail. Vedi', privacy: 'l\'informativa sulla privacy (in tedesco)',
        send: 'Invia richiesta', waBtn: 'Invia invece su WhatsApp', waNote: 'Rispondiamo negli orari telefonici (lun–sab 7–19). I suoi dati vengono inseriti nel messaggio; può allegare le foto lì.', sending: 'Invio in corso …',
        eName: 'Inserisca il suo nome.', ePhone: 'Inserisca un numero di telefono valido.', ePlace: 'Inserisca il luogo del cantiere.', eConcern: 'Descriva brevemente la sua richiesta.',
        ePhoto: 'Impossibile caricare questa foto.', eSend: 'Invio non riuscito. Ci chiami: +49 177 190 90 49 (lun–sab 7–19) o scriva su WhatsApp.',
        thanks: 'Grazie, la sua richiesta è stata inoltrata.', today: 'Di solito la richiamiamo oggi entro le 19.', next: 'Di solito la richiamiamo il giorno lavorativo successivo dalle 7.', wa: 'Può inviare altre foto su WhatsApp.',
        priceIntro: 'Qui può calcolare il prezzo indicativo e scaricarlo come offerta PDF.', priceTitle: 'Calcola il prezzo', dia: 'Diametro (mm)', depth: 'Profondità (cm)', count: 'Quantità', material: 'Materiale', beton: 'Calcestruzzo / armato', mauer: 'Muratura',
        priceNote: 'Prezzo indicativo, non vincolante, lordo, incl. trasferta e foro pilota.', pdf: 'Scarica offerta PDF', pdfBusy: 'Creazione PDF …', pdfFail: 'PDF non disponibile, chieda tramite WhatsApp.',
        err: 'L\'assistente non è al momento disponibile. Ci chiami: +49 177 190 90 49 (lun–sab 7–19) o scriva su WhatsApp.',
      },
    };
    const LANGNAME = { de: 'Deutsch', en: 'Englisch', ro: 'Rumänisch', ru: 'Russisch', it: 'Italienisch' };
    const SPEECH = { de: 'de-DE', en: 'en-US', ro: 'ro-RO', ru: 'ru-RU', it: 'it-IT' };
    let lang = 'de';
    const tt = () => T[lang];

    const words = (s, list) => new RegExp('(^|[^\\p{L}])(' + list + ')(?=$|[^\\p{L}])', 'iu').test(s);
    const detectLang = (t) => {
      if (/[а-яё]/i.test(t)) return 'ru';
      if (/[ăâîșțşţ]/i.test(t) || words(t, 'bună|buna|vreau|cât|costă|cost|mulțumesc|mulțumim|salut|aveți|puteți|gaură|găuri|perete|sunt|dvs|vă rog')) return 'ro';
      if (words(t, 'ciao|buongiorno|salve|quanto|vorrei|grazie|foro|fori|muro|costa|prezzo|potete|lavoro')) return 'it';
      if (words(t, 'hello|hi|how|much|price|cost|the|you|drill|drilling|wall|can|please|need|want|do|is|are')) return 'en';
      if (words(t, 'ich|und|der|die|das|was|kostet|wie|bitte|danke|ja|nein|brauche|haben|sie|wir|kann|nicht|für')) return 'de';
      return null;
    };
    const JA = /^(ja|ja,?\s*bitte|ja,?\s*gerne|gerne|gern|sehr gerne|ok|okay|klar|bitte|yes|yeah|yep|sure|please|da|da,?\s*bine|bine|sigur|desigur|s[ìi]|certo|volentieri|да|давайте|конечно|хорошо)(?![\p{L}])/iu;
    const isYes = (t) => t.length <= 40 && JA.test(t.trim());

    const $ = (s) => root.querySelector(s);
    const fab = $('.kc-fab'), panel = $('#kc-panel'), log = $('.kc-log'), form = $('.kc-form'), input = form.querySelector('input');
    const chips = $('.kc-chips'), consent = $('.kc-consent'), mic = $('.kc-mic'), sl = $('.kc-sl');
    const history = [];
    let formShown = false, offerPending = false, lastPrice = '', started = false;
    const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const link = (t) => esc(t.replace(/\*\*|__/g, '').replace(/[  ]/g, ' ')).replace(/https?:\/\/[^\s<]+[^\s<.,;:!?)]/g, (u) => `<a href="${u}" target="_blank" rel="noopener">${u.includes('wa.me') ? 'WhatsApp' : u.includes('#kb-rechner') ? 'Richtpreis-Rechner' : u}</a>`);
    const add = (cls, html) => { const d = document.createElement('div'); d.className = 'kc-m ' + cls; d.innerHTML = html; log.appendChild(d); log.scrollTop = log.scrollHeight; return d; };
    const bot = (text) => { add('kc-bot', link(text)); history.push({ role: 'assistant', content: text }); };
    const toggle = (open) => { panel.hidden = !open; fab.setAttribute('aria-expanded', String(open)); if (open && !form.hidden) input.focus(); };
    fab.addEventListener('click', () => toggle(panel.hidden));
    document.addEventListener('click', (e) => { if (e.target.closest && e.target.closest('[data-open-chat]')) { e.preventDefault(); toggle(true); } });
    $('.kc-x').addEventListener('click', () => { toggle(false); fab.focus(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) toggle(false); });

    // Seitenkontext: passende Begrüßung und Startfragen
    const path = location.pathname;
    const ctx = /waerme|klima/.test(path) ? 'wp' : /wanddurchbruch|tragende/.test(path) ? 'wd' : /preis|kosten/.test(path) ? 'preis' : 'std';
    const GREET = {
      wp: 'Hallo, ich bin Kerni, der digitale Assistent von Kernbohr-Expert. Haben Sie Fragen zur Kernbohrung für Wärmepumpe oder Klimagerät? Ich helfe gern.',
      wd: 'Hallo, ich bin Kerni, der digitale Assistent von Kernbohr-Expert. Fragen zu Wanddurchbruch, Statik oder Kosten? Fragen Sie mich.',
      preis: 'Hallo, ich bin Kerni, der digitale Assistent von Kernbohr-Expert. Ich helfe Ihnen gern bei der Preisberechnung für Ihre Kernbohrung.',
    };
    const FRAGEN = {
      std: ['Was kostet eine Kernbohrung?', 'Arbeiten Sie nachts?'],
      wp: ['Welcher Durchmesser für die Wärmepumpe?', 'Was kostet die Durchführung?'],
      wd: ['Wer darf einen Wanddurchbruch machen?', 'Was kostet ein Wanddurchbruch?'],
      preis: ['Was ist im Preis enthalten?', 'Gibt es Zuschläge?'],
    };
    const renderChips = (first) => {
      chips.textContent = '';
      const mk = (label, fn) => { const b = document.createElement('button'); b.type = 'button'; b.textContent = label; b.addEventListener('click', fn); chips.appendChild(b); };
      if (first && lang === 'de') FRAGEN[ctx].forEach((q) => mk(q, () => send(q)));
      mk(tt().chipPreis, showPrice);
      if (!formShown) mk(tt().chipAnfrage, showForm);
      if (!first) mk(tt().chipWa, openWa);
      chips.hidden = false;
    };

    $('.kc-ok').addEventListener('click', () => {
      consent.hidden = true; log.hidden = false; form.hidden = false; started = true;
      bot(GREET[ctx] || tt().greet);
      renderChips(true); input.focus();
    });

    // WhatsApp mit Zusammenfassung (Text geht nur an WhatsApp, nicht an unseren Server)
    function openWa(f) {
      if (f && f.anliegen !== undefined) {
        const zeilen = ['Guten Tag Herr Salcutan, ich habe auf Ihrer Website mit Kerni (KI-Assistent) eine Anfrage vorbereitet und sende sie Ihnen hiermit direkt per WhatsApp.',
          f.name ? 'Name: ' + f.name : '', f.telefon ? 'Telefon: ' + f.telefon : '', 'Ort der Baustelle: ' + (f.ort || ''),
          'Anliegen: ' + (f.anliegen || ''), lastPrice ? 'Richtpreis laut Rechner: ' + lastPrice : '',
          lang !== 'de' ? `(Ich schreibe auf ${LANGNAME[lang]}.)` : '', f.fotos ? 'Fotos sende ich gleich hier mit.' : '',
          'Mir ist bewusst, dass Sie in den Telefonzeiten (Mo–Sa 7–19 Uhr) antworten. Vielen Dank!'].filter(Boolean).join('\n');
        window.open((root.dataset.wa || 'https://wa.me/491771909049') + '?text=' + encodeURIComponent(zeilen), '_blank', 'noopener');
        return;
      }
      const fragen = history.filter((m) => m.role === 'user' && !isYes(m.content)).slice(-3).map((m) => m.content.slice(0, 160));
      const txt = ['Hallo Herr Salcutan, ich habe auf Ihrer Website mit Kerni (KI-Assistent) geschrieben.',
        fragen.length ? 'Meine Fragen: ' + fragen.join(' | ') : '', lastPrice ? 'Richtpreis laut Rechner: ' + lastPrice : '',
        lang !== 'de' ? `(Ich schreibe auf ${LANGNAME[lang]}.)` : '', 'Ort der Baustelle: '].filter(Boolean).join('\n');
      window.open((root.dataset.wa || 'https://wa.me/491771909049') + '?text=' + encodeURIComponent(txt), '_blank', 'noopener');
    }

    // Rückruf-Hinweis nach Uhrzeit (Mo–Sa 7–19 Uhr, ohne Gewähr für Feiertage)
    const rueckruf = () => {
      const d = new Date().toLocaleString('en-US', { timeZone: 'Europe/Berlin', weekday: 'short' });
      const h = parseInt(new Date().toLocaleString('en-GB', { timeZone: 'Europe/Berlin', hour: 'numeric', hour12: false }), 10);
      return d !== 'Sun' && h >= 7 && h < 19 ? tt().today : tt().next;
    };

    // Foto verkleinern (max. 1280 px, JPEG): entfernt auch EXIF-Daten wie GPS
    const shrink = (file) => new Promise((res, rej) => {
      const img = new Image(); const u = URL.createObjectURL(file);
      img.onload = () => {
        const k = Math.min(1, 1280 / Math.max(img.width, img.height));
        const c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(u); res(c.toDataURL('image/jpeg', 0.8));
      };
      img.onerror = () => { URL.revokeObjectURL(u); rej(new Error('img')); };
      img.src = u;
    });

    function leadCard(pre = {}) {
      document.querySelectorAll('.kc-lead').forEach((n) => n.remove());
      formShown = true; renderChips(history.filter((m) => m.role === 'user').length === 0);
      const t = tt(); const fotos = [];
      const box = document.createElement('div'); box.className = 'kc-m kc-lead';
      box.innerHTML = `<b>${esc(t.formTitle)}</b>`
        + `<div class="kc-f"><label>${esc(t.name)}<input class="kc-n" autocomplete="name" maxlength="80" value="${esc(pre.name || '')}"></label>`
        + `<label>${esc(t.phone)}<input class="kc-t" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" value="${esc(pre.telefon || '')}"></label>`
        + `<label>${esc(t.place)}<input class="kc-o" maxlength="80" value="${esc(pre.ort || '')}"></label>`
        + `<label>${esc(t.concern)}<textarea class="kc-a" rows="4" maxlength="600">${esc(pre.anliegen || '')}</textarea></label></div>`
        + `<div class="kc-f"><span style="font-weight:600;font-size:.8rem;color:#3a3f45">${esc(t.photos)}</span><div class="kc-ph"><label class="kc-add">${esc(t.addPhoto)}<input type="file" class="kc-file" accept="image/*" multiple></label></div></div>`
        + '<input class="kc-hp" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">'
        + `<label class="kc-cl"><input type="checkbox" class="kc-cb"><span>${esc(t.consent)} <a href="/datenschutzerklaerung/" target="_blank" rel="noopener">${esc(t.privacy)}</a>.</span></label>`
        + '<p class="kc-err" role="alert" hidden></p>'
        + `<button type="button" class="kc-send" disabled>${esc(t.send)}</button>`
        + `<button type="button" class="kc-wa2">${esc(t.waBtn)}</button><p class="kc-wan">${esc(t.waNote)}</p>`;
      log.appendChild(box); requestAnimationFrame(() => { log.scrollTop = Math.max(0, log.scrollTop + box.getBoundingClientRect().top - log.getBoundingClientRect().top - 8); });
      const q = (c) => box.querySelector(c);
      const cb = q('.kc-cb'), btn = q('.kc-send'), err = q('.kc-err'), ph = q('.kc-ph'), file = q('.kc-file'), addL = q('.kc-add');
      const showErr = (m) => { err.textContent = m; err.hidden = false; };
      const drawThumbs = () => {
        ph.querySelectorAll('.kc-th').forEach((n) => n.remove());
        fotos.forEach((f, i) => {
          const d = document.createElement('div'); d.className = 'kc-th';
          const im = document.createElement('img'); im.src = f; im.alt = '';
          const x = document.createElement('button'); x.type = 'button'; x.textContent = '×'; x.setAttribute('aria-label', 'Remove');
          x.addEventListener('click', () => { fotos.splice(i, 1); drawThumbs(); });
          d.append(im, x); ph.insertBefore(d, addL);
        });
        addL.hidden = fotos.length >= 3;
      };
      file.addEventListener('change', async () => {
        err.hidden = true;
        for (const f of [...file.files]) {
          if (fotos.length >= 3) break;
          try { fotos.push(await shrink(f)); } catch { showErr(t.ePhoto); }
        }
        file.value = ''; drawThumbs();
      });
      cb.addEventListener('change', () => { btn.disabled = !cb.checked; });
      q('.kc-wa2').addEventListener('click', () => openWa({ name: q('.kc-n').value.trim(), telefon: q('.kc-t').value.trim(), ort: q('.kc-o').value.trim(), anliegen: q('.kc-a').value.trim(), fotos: fotos.length }));
      btn.addEventListener('click', async () => {
        const lead = { name: q('.kc-n').value.trim(), telefon: q('.kc-t').value.trim(), ort: q('.kc-o').value.trim(), anliegen: q('.kc-a').value.trim() };
        const digits = lead.telefon.replace(/\D/g, '');
        const fehler = lead.name.length < 2 ? t.eName : (digits.length < 6 || digits.length > 16) ? t.ePhone : lead.ort.length < 2 ? t.ePlace : lead.anliegen.length < 5 ? t.eConcern : '';
        if (fehler) { showErr(fehler); return; }
        err.hidden = true; btn.disabled = true; btn.textContent = t.sending;
        try {
          const r = await fetch(root.dataset.url.replace(/\/+$/, '') + '/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...lead, fotos, sprache: lang, einwilligung: cb.checked, hp: q('.kc-hp').value }) });
          const j = await r.json();
          if (!r.ok || !j.ok) throw new Error('send');
          box.innerHTML = `<b>${esc(t.thanks)}</b>${esc(rueckruf())} ${esc(t.wa)}`;
          history.length = 0; formShown = false;
          if (window.kbTrack) window.kbTrack('Kerni-Anfrage');
        } catch {
          btn.disabled = false; btn.textContent = t.send; showErr(t.eSend);
        }
      });
    }
    function showForm() {
      if (formShown) return;
      const fragen = history.filter((m) => m.role === 'user' && !isYes(m.content)).slice(-2).map((m) => m.content).join(' / ');
      bot(tt().formIntro);
      leadCard({ anliegen: fragen.slice(0, 300) });
    }

    // Preiskarte mit PDF-Angebot (Rechenlogik und PDF wie im Richtpreis-Rechner auf der Seite)
    function priceCard(pre = {}) {
      document.querySelectorAll('.kc-price').forEach((n) => n.remove());
      const t = tt();
      const ex = { richtung: pre.richtung || 'normal', zeit: pre.zeit || 'tag', wasser: !!pre.wasser, geruest: !!pre.geruest, tage: pre.tage || 1 };
      const box = document.createElement('div'); box.className = 'kc-m kc-price';
      box.innerHTML = `<b>${esc(t.priceTitle)}</b><div class="kc-pg">`
        + `<label>${esc(t.dia)}<input class="kc-pd" type="number" inputmode="numeric" min="${regeln.minDurchmesser}" max="${regeln.maxDurchmesser}" value="${pre.d || 100}"></label>`
        + `<label>${esc(t.depth)}<input class="kc-pe" type="number" inputmode="numeric" min="1" max="${regeln.maxTiefeCm}" value="${pre.tiefe || 30}"></label>`
        + `<label>${esc(t.count)}<input class="kc-pc" type="number" inputmode="numeric" min="1" max="200" value="${pre.anzahl || 1}"></label>`
        + `<label>${esc(t.material)}<select class="kc-pm"><option value="beton">${esc(t.beton)}</option></select></label></div>`
        + '<div class="kc-pt" aria-live="polite"></div><ul class="kc-pl"></ul>'
        + `<p class="kc-pn">${esc(t.priceNote)}</p><button type="button" class="kc-pdf">${esc(t.pdf)}</button>`;
      log.appendChild(box); requestAnimationFrame(() => { log.scrollTop = Math.max(0, log.scrollTop + box.getBoundingClientRect().top - log.getBoundingClientRect().top - 8); });
      const q = (c) => box.querySelector(c);
      q('.kc-pm').value = 'beton';
      let last = null;
      const num = (el, min, max, def) => { const v = Math.round(Number(el.value)); return Number.isNaN(v) || el.value === '' ? def : Math.min(max, Math.max(min, v)); };
      const update = () => {
        const d = num(q('.kc-pd'), regeln.minDurchmesser, regeln.maxDurchmesser, 100), tiefe = num(q('.kc-pe'), 1, regeln.maxTiefeCm, 30), anzahl = num(q('.kc-pc'), 1, 200, 1);
        const eingabe = { d, tiefe, anzahl, material: q('.kc-pm').value, ...ex };
        const r = berechne(eingabe); last = { eingabe, ergebnis: r };
        q('.kc-pt').textContent = 'ca. ' + eur(r.total);
        q('.kc-pl').textContent = ''; r.posten.forEach((p) => { const li = document.createElement('li'); li.textContent = `${p.t}: ${eur(p.v)}`; q('.kc-pl').appendChild(li); });
        lastPrice = `ca. ${eur(r.total)} (Ø ${d} mm, ${tiefe} cm, ${anzahl}x, ${eingabe.material === 'mauerwerk' ? 'Mauerwerk' : 'Beton'})`;
      };
      box.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', update));
      box.querySelectorAll('input').forEach((el) => el.addEventListener('blur', () => { const mm = { 'kc-pd': [regeln.minDurchmesser, regeln.maxDurchmesser], 'kc-pe': [1, regeln.maxTiefeCm], 'kc-pc': [1, 200] }[el.className]; if (mm && el.value !== '') { el.value = Math.min(mm[1], Math.max(mm[0], Math.round(Number(el.value)))); update(); } }));
      update();
      const pdf = q('.kc-pdf');
      pdf.addEventListener('click', async () => {
        if (!last) return;
        const label = pdf.textContent; pdf.disabled = true; pdf.textContent = t.pdfBusy;
        try {
          const { erstelleAngebotPdf } = await import('../lib/angebotPdf.js');
          await erstelleAngebotPdf({ eingabe: { ...last.eingabe }, ergebnis: last.ergebnis });
        } catch { pdf.textContent = t.pdfFail; setTimeout(() => { pdf.textContent = label; pdf.disabled = false; }, 3500); return; }
        pdf.textContent = label; pdf.disabled = false;
      });
    }
    function showPrice() { bot(tt().priceIntro); priceCard(); }

    async function send(text) {
      text = text.trim(); if (!text) return;
      input.value = '';
      const dl = detectLang(text);
      if (dl && dl !== lang) { lang = dl; input.placeholder = tt().ph; sl.value = lang; }
      const wasOffer = offerPending; offerPending = false;
      add('kc-me', esc(text)); history.push({ role: 'user', content: text });
      if (!formShown && wasOffer && isYes(text)) { showForm(); return; }
      renderChips(false);
      const wait = add('kc-bot kc-typing', '…');
      try {
        const r = await fetch(root.dataset.url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history, lang }) });
        const j = await r.json();
        const reply = j.reply || 'Dazu rufen Sie uns bitte kurz an.';
        wait.remove(); bot(reply);
        if (j.offer) offerPending = true;
        if (j.preis) priceCard(j.preis);
        if (j.lead && !formShown) leadCard(j.lead);
      } catch {
        wait.remove(); add('kc-bot', esc(tt().err));
      }
    }
    form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });

    // Spracheingabe (Browser-Spracherkennung), nur wenn verfügbar
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (SR) {
      mic.hidden = false; sl.hidden = false;
      sl.addEventListener('change', () => { lang = sl.value; input.placeholder = tt().ph; });
      mic.addEventListener('click', () => {
        try {
          const rec = new SR(); rec.lang = SPEECH[lang] || 'de-DE'; rec.interimResults = false; rec.maxAlternatives = 1;
          rec.onresult = (e) => { input.value = (input.value + ' ' + e.results[0][0].transcript).trim(); input.focus(); };
          rec.onend = () => mic.classList.remove('on'); rec.onerror = () => mic.classList.remove('on');
          mic.classList.add('on'); rec.start();
        } catch { mic.classList.remove('on'); }
      });
    }
  }
</script>
