---
// Chat-Assistent. Wird nur eingebunden, wenn PUBLIC_CHAT_URL gesetzt ist (Adresse des Cloudflare Workers).
// Es wird nichts gespeichert (keine Cookies, kein localStorage). Erst nach Zustimmung werden Nachrichten gesendet.
const url = import.meta.env.PUBLIC_CHAT_URL;
---
{url && (
<div id="kb-chat" data-url={url} data-wa="https://wa.me/491771909049">
  <button type="button" class="kc-fab" aria-expanded="false" aria-controls="kc-panel">
    <span class="kc-av kc-av-s"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#e8590c"/><path d="M10 22a14 14 0 0 1 28 0z" fill="#fff"/><rect x="8" y="21" width="32" height="4" rx="2" fill="#f3f4f6"/><rect x="12" y="25" width="24" height="15" rx="6" fill="#171c20"/><circle cx="19" cy="31.5" r="2.6" fill="#7ee0a1"/><circle cx="29" cy="31.5" r="2.6" fill="#7ee0a1"/><path d="M20 36.5q4 2.4 8 0" stroke="#7ee0a1" stroke-width="1.6" fill="none" stroke-linecap="round"/><rect x="22.5" y="6" width="3" height="5" rx="1.5" fill="#fff"/></svg></span>
    <span>Kerni fragen</span>
  </button>
  <section id="kc-panel" class="kc-panel" aria-label="Chat mit Kerni, dem Kernbohr-Expert Assistenten" hidden>
    <header><span class="kc-av"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#e8590c"/><path d="M10 22a14 14 0 0 1 28 0z" fill="#fff"/><rect x="8" y="21" width="32" height="4" rx="2" fill="#f3f4f6"/><rect x="12" y="25" width="24" height="15" rx="6" fill="#171c20"/><circle cx="19" cy="31.5" r="2.6" fill="#7ee0a1"/><circle cx="29" cy="31.5" r="2.6" fill="#7ee0a1"/><path d="M20 36.5q4 2.4 8 0" stroke="#7ee0a1" stroke-width="1.6" fill="none" stroke-linecap="round"/><rect x="22.5" y="6" width="3" height="5" rx="1.5" fill="#fff"/></svg><i class="kc-on"></i></span><span class="kc-title"><span class="kc-name"><b>Kerni</b><em>KI-Assistent</em></span><small>(Kernbohr-Expert Assistent)</small></span><button type="button" class="kc-x" aria-label="Chat schließen">×</button></header>
    <div class="kc-consent">
      <span class="kc-av kc-av-l"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#e8590c"/><path d="M10 22a14 14 0 0 1 28 0z" fill="#fff"/><rect x="8" y="21" width="32" height="4" rx="2" fill="#f3f4f6"/><rect x="12" y="25" width="24" height="15" rx="6" fill="#171c20"/><circle cx="19" cy="31.5" r="2.6" fill="#7ee0a1"/><circle cx="29" cy="31.5" r="2.6" fill="#7ee0a1"/><path d="M20 36.5q4 2.4 8 0" stroke="#7ee0a1" stroke-width="1.6" fill="none" stroke-linecap="round"/><rect x="22.5" y="6" width="3" height="5" rx="1.5" fill="#fff"/></svg></span>
      <p>Kerni ist ein digitaler KI-Assistent, kein Mensch. Ihre Eingaben werden dafür an einen Anbieter in den USA übermittelt. Bitte geben Sie im Chat keine persönlichen Daten ein, außer Sie möchten eine Anfrage an uns senden (dazu bitten wir Sie vorher um eine gesonderte Bestätigung). Kerni versteht auch Englisch, Rumänisch, Russisch und Italienisch. Die optionale Spracheingabe nutzt den Spracherkennungsdienst Ihres Browsers. Der Assistent gibt unverbindliche Auskünfte. Details in der <a href="/datenschutzerklaerung/">Datenschutzerklärung</a>.</p>
      <button type="button" class="kc-ok">Einverstanden, Chat starten</button>
    </div>
    <div class="kc-log" role="log" aria-live="polite" hidden></div>
    <div class="kc-chips" hidden></div>
    <form class="kc-form" hidden>
      <input type="text" maxlength="500" placeholder="Ihre Frage …" aria-label="Ihre Frage" autocomplete="off" />
      <select class="kc-sl" aria-label="Sprache" title="Sprache / Language" hidden><option value="de">DE</option><option value="en">EN</option><option value="ro">RO</option><option value="ru">RU</option><option value="it">IT</option></select>
      <button type="button" class="kc-mic" aria-label="Spracheingabe" title="Spracheingabe" hidden>🎤</button>
      <button type="submit" aria-label="Senden">➤</button>
    </form>
  </section>
</div>
)}

<style is:global>
  #kb-chat{position:fixed;right:14px;bottom:72px;z-index:60;font:15px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
  .kc-fab{display:flex;align-items:center;gap:.45rem;padding:.7rem 1rem;border:0;border-radius:999px;background:#171c20;color:#fff;font-weight:700;box-shadow:0 8px 24px rgba(0,0,0,.35);cursor:pointer;border:2px solid #e8590c;min-height:48px}
  .kc-fab:hover{background:#232b32}
  .kc-panel{position:absolute;right:0;bottom:60px;width:min(380px,calc(100vw - 28px));height:auto;max-height:min(680px,calc(100vh - 120px));max-height:min(680px,calc(100dvh - 120px));padding:0;margin:0;display:flex;flex-direction:column;background:#fff;color:#1b1f23;border-radius:16px;box-shadow:0 18px 50px rgba(0,0,0,.35);overflow:hidden;animation:kc-in .2s ease-out}
  .kc-panel[hidden]{display:none}
  @keyframes kc-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .kc-panel header{display:flex;justify-content:space-between;align-items:center;padding:.8rem 1rem;background:#171c20;color:#fff;border-bottom:3px solid #e8590c}
  .kc-panel header{gap:.7rem}
  .kc-panel header .kc-title{font:inherit;font-size:.95rem;flex:1;min-width:0;display:flex;flex-direction:column;line-height:1.25}
  .kc-name{display:flex;align-items:center;gap:.5rem;font-size:1.05rem}
  .kc-name em{font-style:normal;font-size:.68rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:rgba(126,224,161,.18);color:#7ee0a1;border-radius:999px;padding:.12rem .5rem}
  .kc-av{position:relative;display:inline-flex;flex:none;width:40px;height:40px}
  .kc-av svg{width:100%;height:100%;display:block}
  .kc-av-s{width:30px;height:30px}
  .kc-av-l{width:64px;height:64px;margin:0 0 .6rem}
  .kc-on{position:absolute;right:-1px;bottom:-1px;width:11px;height:11px;border-radius:50%;background:#2ecc71;border:2px solid #171c20}
  .kc-panel header small{font:inherit;font-weight:400;opacity:.8;font-size:.82rem;margin:0}
  .kc-x{background:none;border:0;color:#fff;font-size:1.6rem;line-height:1;cursor:pointer;width:36px;height:36px}
  .kc-consent{padding:1rem;font-size:.9rem;overflow:auto;min-height:0;flex:0 1 auto}
  .kc-consent p{margin:0 0 .8rem}
  .kc-ok{width:100%;padding:.8rem;border:0;border-radius:10px;background:#c2410c;color:#fff;font-weight:700;cursor:pointer;min-height:46px}
  .kc-log{flex:1 1 auto;min-height:min(260px,40vh);min-height:min(260px,40dvh);overscroll-behavior:contain;overflow-y:auto;padding:.8rem;display:flex;flex-direction:column;gap:.5rem;background:#f4f6f8}
  .kc-log[hidden],.kc-chips[hidden],.kc-form[hidden],.kc-consent[hidden]{display:none}
  .kc-m{max-width:88%;padding:.55rem .75rem;border-radius:14px;white-space:pre-wrap;word-wrap:break-word;font-size:.92rem}
  .kc-m a{color:inherit;text-decoration:underline;font-weight:600}
  .kc-bot{align-self:flex-start;background:#fff;border:1px solid #e3e6e9;border-bottom-left-radius:4px}
  .kc-me{align-self:flex-end;background:#c2410c;color:#fff;border-bottom-right-radius:4px}
  .kc-typing{opacity:.6}
  .kc-lead{align-self:stretch;background:#fff;border:2px solid #e8590c;border-radius:12px;padding:.7rem .8rem;font-size:.88rem}
  .kc-lead b{display:block;margin-bottom:.3rem}
  .kc-f{display:grid;gap:.5rem;margin:0 0 .6rem}
  .kc-f label{display:grid;gap:.2rem;font-weight:600;font-size:.8rem;color:#3a3f45}
  .kc-f input,.kc-f textarea{font:inherit;font-weight:400;font-size:16px;padding:.5rem .6rem;border:1px solid #c9ced4;border-radius:8px;width:100%;box-sizing:border-box}
  .kc-err{color:#b42318;font-size:.82rem;margin:0 0 .5rem}
  .kc-lead .kc-cl{display:flex;gap:.5rem;align-items:flex-start;font-size:.8rem;margin:0 0 .6rem;line-height:1.35}
  .kc-lead input[type=checkbox]{margin-top:.15rem;width:18px;height:18px;flex:none}
  .kc-lead .kc-send{width:100%;min-height:44px;border:0;border-radius:10px;background:#c2410c;color:#fff;font-weight:700;cursor:pointer}
  .kc-lead .kc-wa2{width:100%;min-height:44px;margin-top:.5rem;border:1.5px solid #1f9d55;border-radius:10px;background:#fff;color:#177a43;font-weight:700;cursor:pointer}
  .kc-lead .kc-wan{margin:.4rem 0 0;font-size:.78rem;line-height:1.35;color:#5b6168}
  .kc-lead .kc-send:disabled{opacity:.5;cursor:not-allowed}
  .kc-lead .kc-hp{position:absolute;left:-9999px;opacity:0;height:0;width:0}
  .kc-chips{display:flex;gap:.4rem;padding:.5rem .8rem;flex-wrap:wrap;background:#f4f6f8}
  .kc-mic{flex:0 0 44px;width:44px;border:1.5px solid #cfd5da;border-radius:10px;background:#fff;font-size:1.05rem;cursor:pointer}
  .kc-mic.on{background:#fee2e2;border-color:#b42318}
  .kc-mic[hidden],.kc-sl[hidden]{display:none}
  .kc-sl{flex:0 0 auto;width:58px;max-width:58px;min-height:44px;border:1.5px solid #cfd5da;border-radius:10px;background:#fff;font:700 13px/1 system-ui,sans-serif;padding:0 .2rem;cursor:pointer}
  .kc-ph{display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;margin:.2rem 0 .6rem}
  .kc-ph label.kc-add{display:inline-block;border:1.5px dashed #c2410c;color:#c2410c;border-radius:8px;padding:.45rem .7rem;font-weight:600;font-size:.82rem;cursor:pointer}
  .kc-ph input[type=file]{position:absolute;left:-9999px;opacity:0;width:1px;height:1px}
  .kc-th{position:relative;width:54px;height:54px}
  .kc-th img{width:100%;height:100%;object-fit:cover;border-radius:8px;border:1px solid #c9ced4}
  .kc-th button{position:absolute;top:-6px;right:-6px;width:22px;height:22px;border-radius:50%;border:0;background:#171c20;color:#fff;font-size:.9rem;line-height:1;cursor:pointer}
  .kc-m.kc-lead,.kc-m.kc-price{max-width:100%}
  .kc-price{align-self:stretch;background:#fff;border:2px solid #171c20;border-radius:12px;padding:.7rem .8rem;font-size:.88rem}
  .kc-price b{display:block;margin-bottom:.4rem}
  .kc-pg{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin-bottom:.6rem}
  .kc-pg label{display:grid;gap:.2rem;font-weight:600;font-size:.78rem;color:#3a3f45}
  .kc-pg input,.kc-pg select{font:inherit;font-weight:400;font-size:16px;padding:.45rem .5rem;border:1px solid #c9ced4;border-radius:8px;width:100%;box-sizing:border-box;background:#fff}
  .kc-pt{font-size:1.5rem;font-weight:800;color:#c2410c;margin:.1rem 0}
  .kc-pl{margin:.2rem 0 .5rem;padding-left:1.1rem;font-size:.78rem;color:#4a5057}
  .kc-pn{font-size:.76rem;color:#5a6068;margin:0 0 .6rem}
  .kc-price .kc-pdf{width:100%;min-height:44px;border:0;border-radius:10px;background:#171c20;color:#fff;font-weight:700;cursor:pointer}
  .kc-price .kc-pdf:disabled{opacity:.6;cursor:wait}
  .kc-chips button{border:1px solid #e8590c;background:#fff;color:#c2410c;border-radius:999px;padding:.35rem .7rem;font-size:.8rem;font-weight:600;cursor:pointer}
  .kc-form{display:flex;gap:.4rem;padding:.6rem;border-top:1px solid #e3e6e9;background:#fff}
  .kc-form input{flex:1 1 0;min-width:0;min-height:44px;border:1.5px solid #cfd5da;border-radius:10px;padding:0 .7rem;font:inherit}
  .kc-form input:focus{outline:0;border-color:#e8590c;box-shadow:0 0 0 3px rgba(232,89,12,.2)}
  .kc-form button{flex:0 0 48px;width:48px;border:0;border-radius:10px;background:#e8590c;color:#fff;font-size:1.1rem;cursor:pointer}
  @media (min-width:769px){#kb-chat{bottom:20px}}
  @media (max-width:768px){
    #kb-chat{bottom:calc(66px + env(safe-area-inset-bottom))}
    .kc-panel:has(.kc-lead) .kc-chips,.kc-panel:has(.kc-price) .kc-chips{display:none}
    .kc-panel{position:fixed;right:8px;left:8px;width:auto;bottom:calc(60px + env(safe-area-inset-bottom));height:auto;max-height:calc(100vh - 144px - env(safe-area-inset-bottom));max-height:calc(100dvh - 144px - env(safe-area-inset-bottom))}
  }
