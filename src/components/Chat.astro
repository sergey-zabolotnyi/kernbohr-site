---
// Chat-Assistent. Wird nur eingebunden, wenn PUBLIC_CHAT_URL gesetzt ist (Adresse des Cloudflare Workers).
// Es wird nichts gespeichert (keine Cookies, kein localStorage). Erst nach Zustimmung werden Nachrichten gesendet.
const url = import.meta.env.PUBLIC_CHAT_URL;
---
{url && (
<div id="kb-chat" data-url={url} data-wa="https://wa.me/491771909049">
  <button type="button" class="kc-fab" aria-expanded="false" aria-controls="kc-panel">
    <span class="kc-av kc-av-s"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#e8590c"/><path d="M10 22a14 14 0 0 1 28 0z" fill="#fff"/><rect x="8" y="21" width="32" height="4" rx="2" fill="#f3f4f6"/><rect x="12" y="25" width="24" height="15" rx="6" fill="#171c20"/><circle cx="19" cy="31.5" r="2.6" fill="#7ee0a1"/><circle cx="29" cy="31.5" r="2.6" fill="#7ee0a1"/><path d="M20 36.5q4 2.4 8 0" stroke="#7ee0a1" stroke-width="1.6" fill="none" stroke-linecap="round"/><rect x="22.5" y="6" width="3" height="5" rx="1.5" fill="#fff"/></svg></span>
    <span>Kerni fragen</span>
  </button>
  <section id="kc-panel" class="kc-panel" aria-label="Chat mit Kerni, dem Kernbohr-Expert Assistenten" hidden>
    <header><span class="kc-av"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#e8590c"/><path d="M10 22a14 14 0 0 1 28 0z" fill="#fff"/><rect x="8" y="21" width="32" height="4" rx="2" fill="#f3f4f6"/><rect x="12" y="25" width="24" height="15" rx="6" fill="#171c20"/><circle cx="19" cy="31.5" r="2.6" fill="#7ee0a1"/><circle cx="29" cy="31.5" r="2.6" fill="#7ee0a1"/><path d="M20 36.5q4 2.4 8 0" stroke="#7ee0a1" stroke-width="1.6" fill="none" stroke-linecap="round"/><rect x="22.5" y="6" width="3" height="5" rx="1.5" fill="#fff"/></svg><i class="kc-on"></i></span><span class="kc-title"><span class="kc-name"><b>Kerni</b><em>KI-Assistent</em></span><small>(Kernbohr-Expert Assistent)</small></span><button type="button" class="kc-x" aria-label="Chat schließen">×</button></header>
    <div class="kc-consent">
      <span class="kc-av kc-av-l"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#e8590c"/><path d="M10 22a14 14 0 0 1 28 0z" fill="#fff"/><rect x="8" y="21" width="32" height="4" rx="2" fill="#f3f4f6"/><rect x="12" y="25" width="24" height="15" rx="6" fill="#171c20"/><circle cx="19" cy="31.5" r="2.6" fill="#7ee0a1"/><circle cx="29" cy="31.5" r="2.6" fill="#7ee0a1"/><path d="M20 36.5q4 2.4 8 0" stroke="#7ee0a1" stroke-width="1.6" fill="none" stroke-linecap="round"/><rect x="22.5" y="6" width="3" height="5" rx="1.5" fill="#fff"/></svg></span>
      <p>Kerni ist ein digitaler KI-Assistent, kein Mensch. Ihre Eingaben werden dafür an einen Anbieter in den USA übermittelt. Bitte geben Sie keine persönlichen Daten ein. Der Assistent gibt unverbindliche Auskünfte. Details in der <a href="/datenschutzerklaerung/">Datenschutzerklärung</a>.</p>
      <button type="button" class="kc-ok">Einverstanden, Chat starten</button>
    </div>
    <div class="kc-log" role="log" aria-live="polite" hidden></div>
    <div class="kc-chips" hidden>
      <button type="button">Was kostet eine Kernbohrung?</button>
      <button type="button">Arbeiten Sie nachts?</button>
      <button type="button">Wie schnell sind Sie vor Ort?</button>
    </div>
    <form class="kc-form" hidden>
      <input type="text" maxlength="500" placeholder="Ihre Frage …" aria-label="Ihre Frage" autocomplete="off" />
      <button type="submit" aria-label="Senden">➤</button>
    </form>
  </section>
</div>
)}

<style is:global>
  #kb-chat{position:fixed;right:14px;bottom:72px;z-index:60;font:15px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
  .kc-fab{display:flex;align-items:center;gap:.45rem;padding:.7rem 1rem;border:0;border-radius:999px;background:#171c20;color:#fff;font-weight:700;box-shadow:0 8px 24px rgba(0,0,0,.35);cursor:pointer;border:2px solid #e8590c;min-height:48px}
  .kc-fab:hover{background:#232b32}
  .kc-panel{position:absolute;right:0;bottom:60px;width:min(380px,calc(100vw - 28px));height:min(560px,calc(100vh - 150px));display:flex;flex-direction:column;background:#fff;color:#1b1f23;border-radius:16px;box-shadow:0 18px 50px rgba(0,0,0,.35);overflow:hidden;animation:kc-in .2s ease-out}
  .kc-panel[hidden]{display:none}
  @keyframes kc-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .kc-panel header{display:flex;justify-content:space-between;align-items:center;padding:.8rem 1rem;background:#171c20;color:#fff;border-bottom:3px solid #e8590c}
  .kc-panel header{gap:.7rem}
  .kc-panel header .kc-title{font:inherit;font-size:.95rem;flex:1;min-width:0;display:flex;flex-direction:column;line-height:1.25}
  .kc-name{display:flex;align-items:center;gap:.5rem;font-size:1.05rem}
  .kc-name em{font-style:normal;font-size:.68rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:rgba(126,224,161,.18);color:#7ee0a1;border-radius:999px;padding:.12rem .5rem}
  .kc-av{position:relative;display:inline-flex;flex:none;width:40px;height:40px}
  .kc-av svg{width:100%;height:100%;display:block}
  .kc-av-s{width:30px;height:30px}
  .kc-av-l{width:64px;height:64px;margin:0 0 .6rem}
  .kc-on{position:absolute;right:-1px;bottom:-1px;width:11px;height:11px;border-radius:50%;background:#2ecc71;border:2px solid #171c20}
  .kc-panel header small{font:inherit;font-weight:400;opacity:.8;font-size:.82rem;margin:0}
  .kc-x{background:none;border:0;color:#fff;font-size:1.6rem;line-height:1;cursor:pointer;width:36px;height:36px}
  .kc-consent{padding:1rem;font-size:.9rem;overflow:auto}
  .kc-consent p{margin:0 0 .8rem}
  .kc-ok{width:100%;padding:.8rem;border:0;border-radius:10px;background:#c2410c;color:#fff;font-weight:700;cursor:pointer;min-height:46px}
  .kc-log{flex:1;overflow-y:auto;padding:.8rem;display:flex;flex-direction:column;gap:.5rem;background:#f4f6f8}
  .kc-log[hidden],.kc-chips[hidden],.kc-form[hidden],.kc-consent[hidden]{display:none}
  .kc-m{max-width:88%;padding:.55rem .75rem;border-radius:14px;white-space:pre-wrap;word-wrap:break-word;font-size:.92rem}
  .kc-m a{color:inherit;text-decoration:underline;font-weight:600}
  .kc-bot{align-self:flex-start;background:#fff;border:1px solid #e3e6e9;border-bottom-left-radius:4px}
  .kc-me{align-self:flex-end;background:#c2410c;color:#fff;border-bottom-right-radius:4px}
  .kc-typing{opacity:.6}
  .kc-chips{display:flex;gap:.4rem;padding:.5rem .8rem;flex-wrap:wrap;background:#f4f6f8}
  .kc-chips button{border:1px solid #e8590c;background:#fff;color:#c2410c;border-radius:999px;padding:.35rem .7rem;font-size:.8rem;font-weight:600;cursor:pointer}
  .kc-form{display:flex;gap:.4rem;padding:.6rem;border-top:1px solid #e3e6e9;background:#fff}
  .kc-form input{flex:1;min-height:44px;border:1.5px solid #cfd5da;border-radius:10px;padding:0 .7rem;font:inherit}
  .kc-form input:focus{outline:0;border-color:#e8590c;box-shadow:0 0 0 3px rgba(232,89,12,.2)}
  .kc-form button{width:48px;border:0;border-radius:10px;background:#e8590c;color:#fff;font-size:1.1rem;cursor:pointer}
  @media (min-width:769px){#kb-chat{bottom:20px}}
  @media (max-width:768px){
    #kb-chat{bottom:calc(66px + env(safe-area-inset-bottom))}
    .kc-panel{position:fixed;right:8px;left:8px;width:auto;bottom:calc(60px + env(safe-area-inset-bottom));height:min(70vh,520px);height:min(72dvh,540px)}
  }
</style>

<script>
  const root = document.getElementById('kb-chat');
  if (root) {
    const $ = (s) => root.querySelector(s);
    const fab = $('.kc-fab'), panel = $('#kc-panel'), log = $('.kc-log'), form = $('.kc-form'), input = form.querySelector('input');
    const chips = $('.kc-chips'), consent = $('.kc-consent');
    const history = [];
    const esc = (t) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const link = (t) => esc(t.replace(/\*\*|__/g, '').replace(/[\u202f\u00a0]/g, ' ')).replace(/https?:\/\/[^\s<]+[^\s<.,;:!?)]/g, (u) => `<a href="${u}" target="_blank" rel="noopener">${u.includes('wa.me') ? 'WhatsApp öffnen' : u}</a>`);
    const add = (cls, html) => { const d = document.createElement('div'); d.className = 'kc-m ' + cls; d.innerHTML = html; log.appendChild(d); log.scrollTop = log.scrollHeight; return d; };
    const toggle = (open) => { panel.hidden = !open; fab.setAttribute('aria-expanded', String(open)); if (open && !form.hidden) input.focus(); };
    fab.addEventListener('click', () => toggle(panel.hidden));
    $('.kc-x').addEventListener('click', () => { toggle(false); fab.focus(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) toggle(false); });
    $('.kc-ok').addEventListener('click', () => {
      consent.hidden = true; log.hidden = false; chips.hidden = false; form.hidden = false;
      add('kc-bot', 'Hallo, ich bin Kerni, der digitale Assistent von Kernbohr-Expert. Ich beantworte Fragen zu Kernbohrung, Preisen und Ablauf. Wie kann ich helfen?');
      input.focus();
    });
    async function send(text) {
      text = text.trim(); if (!text) return;
      chips.hidden = true; input.value = '';
      add('kc-me', esc(text)); history.push({ role: 'user', content: text });
      const wait = add('kc-bot kc-typing', '…');
      try {
        const r = await fetch(root.dataset.url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history }) });
        const j = await r.json();
        const reply = j.reply || 'Dazu rufen Sie uns bitte kurz an.';
        wait.remove(); add('kc-bot', link(reply)); history.push({ role: 'assistant', content: reply });
      } catch {
        wait.remove(); add('kc-bot', 'Der Assistent ist gerade nicht erreichbar. Bitte rufen Sie uns an: +49 177 190 90 49 (Mo–Sa 7–19 Uhr) oder schreiben Sie per WhatsApp.');
      }
    }
    form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });
    chips.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => send(b.textContent)));
  }
</script>
