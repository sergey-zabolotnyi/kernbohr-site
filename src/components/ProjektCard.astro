---
// Projekt-Karte: nur mit echten Projektdaten verwenden (siehe src/data/projekte.js).
import Photo from './Photo.astro';
const { p } = Astro.props;
const href = p.slug ? `/referenzen/${p.slug}/` : null;
---
<article class="projekt">
  {p.vorher && p.nachher ? (
    <div class="ba">
      <figure><img src={p.vorher} alt={`${p.titel}: vorher`} loading="lazy" /><figcaption><span class="pill pill-dark">Vorher</span></figcaption></figure>
      <figure><img src={p.nachher} alt={`${p.titel}: nachher`} loading="lazy" /><figcaption><span class="pill pill-ok">Nachher</span></figcaption></figure>
    </div>
  ) : (p.foto && <Photo id={p.foto} class="card-img" sizes="(max-width: 700px) 100vw, 400px" />)}
  <div class="projekt-body">
    <h3>{href ? <a href={href}>{p.titel}</a> : p.titel}</h3>
    <p class="meta">{p.ort}</p>
    {p.kurz && <p>{p.kurz}</p>}
    <div class="pills">
      {p.durchmesser && <span class="pill pill-accent">Ø {p.durchmesser} mm</span>}
      {p.tiefe && <span class="pill pill-accent">{p.tiefe} cm tief</span>}
      {p.material && <span class="pill pill-soft">{p.material}</span>}
      {p.dauer && <span class="pill pill-dark">{p.dauer}</span>}
    </div>
    {href && <p><a class="more" href={href}>Projekt ansehen →</a></p>}
  </div>
</article>
