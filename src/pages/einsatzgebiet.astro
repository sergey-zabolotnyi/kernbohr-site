---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroPreload from '../components/HeroPreload.astro';
import { heroStyle } from '../lib/media.js';
import { crumbSchema } from '../lib/schema.js';
import { orte } from '../data/orte.js';
import { regeln, eur } from '../data/preisliste.js';

const stadtteile = ['Altstadt', 'Neustadt', 'Pieschen', 'Striesen', 'Blasewitz', 'Loschwitz', 'Johannstadt', 'Plauen', 'Löbtau', 'Cotta', 'Gorbitz', 'Prohlis', 'Leuben', 'Klotzsche', 'Lockwitz'];
const umland = ['Radebeul', 'Coswig', 'Meißen', 'Pirna', 'Heidenau', 'Freital', 'Radeberg', 'Dippoldiswalde', 'Rabenau', 'Glashütte', 'Bad Gottleuba-Berggießhübel'];
const bundesweit = ['Leipzig', 'Berlin', 'Chemnitz', 'Thüringen', 'Brandenburg', 'Bayern'];
---
<Base
  title="Einsatzgebiet: Kernbohrung Dresden, Leipzig, bundesweit"
  description="Kernbohrung und Betonbearbeitung in Dresden und in der Nähe (Radebeul, Meißen, Pirna, Freital, Radeberg), in Leipzig, bis Berlin und bundesweit nach Absprache."
  path="/einsatzgebiet/"
  schema={[crumbSchema([['Einsatzgebiet', '/einsatzgebiet/']])]}
>
  <Breadcrumbs items={[['Einsatzgebiet']]} />
  <HeroPreload slot="head" id={'werk-fassade'} />
  <section class="hero small" style={heroStyle('werk-fassade')}>
    <div class="wrap">
      <div>
        <span class="eyebrow">Einsatzgebiet</span>
        <h1>Kernbohrung in Dresden, Leipzig, Sachsen und bundesweit</h1>
        <p class="lead">Unser Sitz ist Dresden. Von hier aus erreichen wir alle Stadtteile und das Umland schnell. Auch in Leipzig sind wir regelmäßig im Einsatz, für Projekte bis Berlin und deutschlandweit nach Absprache. Sie suchen eine Kernbohrung in der Nähe? Rufen Sie uns an.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cards">
        <div class="card">
          <div class="ico"><Icon name="pin" size={28} /></div>
          <h3>Dresden</h3>
          <p>Wir arbeiten in allen Stadtteilen, unter anderem:</p>
          <ul class="chips">{stadtteile.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="card">
          <div class="ico"><Icon name="truck" size={28} /></div>
          <h3>Umland</h3>
          <p>Im Raum Dresden und Ostsachsen unter anderem:</p>
          <ul class="chips">{umland.map((s) => { const o = orte.find((x) => x.name === s); return <li>{o ? <a href={`/kernbohrung-in-${o.slug}/`}>{s}</a> : s}</li>; })}</ul>
        </div>
        <div class="card">
          <div class="ico"><Icon name="map" size={28} /></div>
          <h3>Bundesweit</h3>
          <p>Leipzig, Berlin und größere Projekte deutschlandweit, unter anderem in:</p>
          <ul class="chips">{bundesweit.map((s) => { const o = orte.find((x) => x.name === s); return <li>{o ? <a href={`/kernbohrung-in-${o.slug}/`}>{s}</a> : s}</li>; })}</ul>
          <p>Weitere Einsätze auf Anfrage. Anfahrt, Übernachtung und Einsatzdauer vereinbaren wir individuell.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <span class="eyebrow">Anfahrt und Preis</span>
      <h2>Was kostet die Anfahrt?</h2>
      <p>Im Umkreis bis ca. 30 km um Dresden berechnen wir Anfahrt und Baustelleneinrichtung pauschal mit {eur(regeln.anfahrt)} je Einsatz. Das gilt für alle Dresdner Stadtteile sowie für Radebeul, Coswig, Meißen, Pirna, Heidenau, Freital und Radeberg. Für Leipzig, Berlin und weiter entfernte Ziele vereinbaren wir Anfahrt, Übernachtung und Einsatzdauer individuell, vor allem bei größeren Projekten.</p>
      <h2>Wie schnell sind wir vor Ort?</h2>
      <p>Telefonisch erreichen Sie uns Mo–Sa 7–19 Uhr. Kurzfristige Termine sind oft möglich, Einsätze abends, nachts und am Wochenende vereinbaren wir nach Absprache (mit den Zuschlägen aus der Preisliste). Senden Sie uns ein Foto per WhatsApp, dann nennen wir Ihnen Preis und Terminvorschlag.</p>
      <h2>Kernbohrung in der Nähe: so finden Sie uns</h2>
      <p>Unser Sitz ist {`Burkersdorfer Weg 19, 01189 Dresden`}. Die Wege im Raum Dresden sind kurz, deshalb sind wir für die meisten Aufträge in der Region schnell erreichbar. Ob Ihr Ort im Einsatzgebiet liegt, klären wir in einem kurzen Anruf.</p>
      <div class="btns"><a class="btn btn-main" href="/kernbohrung-rechner/">Richtpreis berechnen</a><a class="btn btn-dark" href="/kontakt/">Termin anfragen</a></div>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <span class="eyebrow">Gut zu wissen</span>
      <h2>Besonderheiten in Dresden</h2>
      <p class="lead">Altbau, Plattenbau, Denkmalschutz: Was dabei zu beachten ist, haben wir im Ratgeber zusammengefasst.</p>
      <div class="btns"><a class="btn btn-main" href="/ratgeber/kernbohrung-dresden-altbau-plattenbau/">Zum Ratgeber <Icon name="arrow" size={18} /></a></div>
    </div>
  </section>

  <CtaBand />
</Base>
