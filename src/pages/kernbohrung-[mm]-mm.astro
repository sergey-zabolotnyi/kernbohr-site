---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import HeroPreload from '../components/HeroPreload.astro';
import { heroStyle } from '../lib/media.js';
import { crumbSchema, faqSchema } from '../lib/schema.js';
import { projekte } from '../data/projekte.js';
import { durchmesserSeiten } from '../data/durchmesserSeiten.js';
import { satz, berechne, eur, regeln } from '../data/preisliste.js';
import { site } from '../data/site.js';

export function getStaticPaths() {
  return durchmesserSeiten.map((d) => ({ params: { mm: String(d.mm) }, props: { d } }));
}
const { d } = Astro.props;
const beton = satz(d.mm, 'beton');
const mauer = satz(d.mm, 'mauerwerk');
// Beispiele aus der Preisliste (eine Bohrung, Tiefe ist ein Beispiel)
const bsp = [
  ['1 Bohrung, Mauerwerk 24 cm', { d: d.mm, tiefe: 24, anzahl: 1, material: 'mauerwerk' }],
  ['1 Bohrung, Beton 40 cm', { d: d.mm, tiefe: 40, anzahl: 1, material: 'beton' }],
  ['6 Bohrungen, Beton 25 cm', { d: d.mm, tiefe: 25, anzahl: 6, material: 'beton' }],
].map(([t, p]) => ({ t, r: berechne(p), bohr: berechne(p).posten[0].v + regeln.pilotbohrung * p.anzahl }));
const bohrpreis = (tiefe, material, anzahl = 1) => berechne({ d: d.mm, tiefe, material, anzahl }).posten[0].v + regeln.pilotbohrung * anzahl;
const tiefen = [20, 30, 50, 80, 100].map((t) => ({ t, b: bohrpreis(t, 'beton'), m: bohrpreis(t, 'mauerwerk') }));
const referenz = projekte.find((x) => x.slug && x.durchmesser === d.mm);
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hallo, ich brauche eine Kernbohrung mit Ø ${d.mm} mm. Foto der Baustelle sende ich gleich mit.`)}`;
const faqs = [
  [`Was kostet eine Kernbohrung mit ${d.mm} mm?`, `In Beton oder Stahlbeton kostet Ø ${d.mm} mm ${eur(beton)} je cm Bohrtiefe, in Mauerwerk ${eur(mauer)} je cm (Preisliste 2026, brutto). Dazu kommen Anfahrt (${eur(regeln.anfahrt)} im Umkreis bis ca. 30 km um Dresden) und Pilotbohrung. Der Mindestauftragswert beträgt ${eur(regeln.mindestpreis)}. Beispiel: 6 Bohrungen Ø ${d.mm} mm in Beton, je 25 cm tief, kosten ${eur(bsp[2].bohr)} brutto (Bohrpreis inklusive Pilotbohrung, zuzüglich einmaliger Anfahrt). ${bsp[0].r.mindestpreisGreift ? 'Eine einzelne Bohrung bleibt bei diesem Durchmesser meist unter dem Mindestauftragswert von ' + eur(regeln.mindestpreis) + ' je Auftrag, deshalb lohnt es sich, Bohrungen in einem Termin zu bündeln.' : ''}`],
  [`Was kostet eine Kernbohrung mit ${d.mm} mm durch 80 cm Beton?`, `Eine Bohrung Ø ${d.mm} mm durch 80 cm Beton oder Stahlbeton kostet nach Preisliste 2026 ${eur(tiefen[3].b)} brutto (Bohrpreis inklusive Pilotbohrung). Dazu kommt einmal je Einsatz die Anfahrt von ${eur(regeln.anfahrt)} im Umkreis bis ca. 30 km um Dresden. Weitere Tiefen finden Sie in der Tabelle auf dieser Seite. Der Mindestauftragswert von ${eur(regeln.mindestpreis)} gilt je Auftrag, nicht je Bohrung. Bei Bewehrung kommt Stahl ab 1,5 cm mit ${eur(regeln.stahlProCm)} je cm hinzu.`],
  ...d.faq,
];
const title = `Kernbohrung ${d.mm} mm: Kosten und Anwendung`;
const description = `Kernbohrung Ø ${d.mm} mm in Dresden: ${eur(beton)}/cm in Beton, ${eur(mauer)}/cm in Mauerwerk. Anwendung, Beispielpreise, Richtpreis-Rechner. Kernbohr-Expert.`;
const schema = [
  crumbSchema([['Bohrdurchmesser', '/bohrdurchmesser/'], [`Ø ${d.mm} mm`, `/kernbohrung-${d.mm}-mm/`]]),
  faqSchema(faqs),
];
---
<Base title={title} description={description} path={`/kernbohrung-${d.mm}-mm/`} schema={schema}>
  <Breadcrumbs items={[['Bohrdurchmesser', '/bohrdurchmesser/'], [`Ø ${d.mm} mm`]]} />
  <HeroPreload slot="head" id={d.hero} />
  <section class="hero small" style={heroStyle(d.hero)}>
    <div class="wrap">
      <div>
        <span class="eyebrow">Kernbohrung Ø {d.mm} mm</span>
        <h1>Kernbohrung {d.mm} mm: Kosten und Anwendung</h1>
        <p class="lead">{d.intro}</p>
        <div class="btns">
          <a class="btn btn-main" href="/kernbohrung-rechner/"><Icon name="euro" size={20} /> Richtpreis berechnen</a>
          <a class="btn btn-wa" href={wa} rel="noopener"><Icon name="whatsapp" size={20} /> Foto senden</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Auf einen Blick</span>
      <h2>Preis für Ø {d.mm} mm (Preisliste 2026)</h2>
      <div class="table-scroll" tabindex="0" role="group" aria-label="Tabelle (seitlich scrollbar)">
        <table class="facts">
          <tbody>
            <tr><th>Preis in Beton / Stahlbeton</th><td>{eur(beton)} je cm Bohrtiefe</td></tr>
            <tr><th>Preis in Mauerwerk</th><td>{eur(mauer)} je cm Bohrtiefe</td></tr>
            <tr><th>Anfahrt und Baustelleneinrichtung</th><td>{eur(regeln.anfahrt)} (Umkreis bis ca. 30 km um Dresden)</td></tr>
            <tr><th>Mindestauftragswert</th><td>{eur(regeln.mindestpreis)}</td></tr>
            <tr><th>Bohrtiefe</th><td>bis 2 m</td></tr>
          </tbody>
        </table>
      </div>

      <h2>Beispielrechnungen für Ø {d.mm} mm</h2>
      <div class="table-scroll" tabindex="0" role="group" aria-label="Tabelle (seitlich scrollbar)">
        <table class="facts">
          <thead><tr><th>Beispiel</th><th>Bohrpreis brutto inkl. Pilotbohrung (ohne Anfahrt)</th></tr></thead>
          <tbody>
            {bsp.map((b) => <tr><th scope="row">{b.t}</th><td><strong>{eur(b.bohr)}</strong></td></tr>)}
          </tbody>
        </table>
      </div>
      <h2>Preis nach Wandstärke für Ø {d.mm} mm</h2>
      <div class="table-scroll" tabindex="0" role="group" aria-label="Tabelle (seitlich scrollbar)">
        <table class="facts">
          <thead><tr><th>Bohrtiefe</th><th>Beton / Stahlbeton</th><th>Mauerwerk</th></tr></thead>
          <tbody>
            {tiefen.map((x) => <tr><th scope="row">{x.t} cm</th><td><strong>{eur(x.b)}</strong></td><td>{eur(x.m)}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>Bohrpreis einer Bohrung, brutto, inklusive Pilotbohrung. Die Anfahrt ({eur(regeln.anfahrt)}) kommt nur einmal je Einsatz hinzu. Bewehrungsstahl (ab 1,5 cm) wird je cm zusätzlich berechnet. Mehr zum Material auf unserer Seite <a href="/kernbohrung-beton-stahlbeton/">Kernbohrung in Beton und Stahlbeton</a>. Mindestauftragswert: Erst wenn die Summe eines Auftrags unter {eur(regeln.mindestpreis)} liegt, gilt {eur(regeln.mindestpreis)} für den gesamten Auftrag, nicht je Bohrung. Mehrere Bohrungen in einem Termin werden zusammengerechnet.</p>

      <p>Anzahl und Tiefen sind Beispiele. Ihr genauer Richtwert hängt von Wandstärke, Anzahl und Material ab. Rechnen Sie ihn im <a href="/kernbohrung-rechner/">Kernbohr-Rechner</a> aus. Unverbindliche Schätzung, verbindlich ist erst unser Angebot.</p>

      <h2>Wofür passt Ø {d.mm} mm?</h2>
      <div class="cards">
        {d.anwendungen.map(([t, p]) => (
          <div class="card"><h3>{t}</h3><p>{p}</p></div>
        ))}
      </div>
      <div class="callout"><strong>Tipp</strong> {d.tipp}</div>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <span class="eyebrow">FAQ</span>
      <h2>Häufige Fragen zur Bohrung mit {d.mm} mm</h2>
      {faqs.map(([q, a]) => (
        <details open><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Weitere Durchmesser</span>
      {referenz && <p>Aus der Praxis: <a href={`/referenzen/${referenz.slug}/`}>{referenz.titel}</a>.</p>}

      <h2>Andere Bohrdurchmesser</h2>
      <ul class="chips">
        {durchmesserSeiten.filter((x) => x.mm !== d.mm).map((x) => <li><a href={`/kernbohrung-${x.mm}-mm/`}>Ø {x.mm} mm</a></li>)}
        <li><a href="/kernbohrung-beton-stahlbeton/">Beton und Stahlbeton</a></li>
        <li><a href="/bohrdurchmesser/">Alle Richtwerte</a></li>
        <li><a href="/preise/">Komplette Preisliste</a></li>
      </ul>
    </div>
  </section>

  <CtaBand title="Foto senden, Festpreis erhalten" text="Schicken Sie uns ein Foto der Bohrstelle mit Maßband. Wir nennen Ihnen Durchmesser und Preis, kostenlos und unverbindlich." />
</Base>
