---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/services.js';
import { heroStyle } from '../lib/media.js';
import { crumbSchema } from '../lib/schema.js';
const leistungen = services.filter((s) => s.group === 'Leistung');
const anwendungen = services.filter((s) => s.group === 'Anwendung');
---
<Base
  title="Leistungen: Kernbohrung, Betonsägen, Rückbau Dresden"
  description="Kernbohrungen, Durchbrüche, Betonsägen, Fugenschneiden, Schlitze fräsen und Rückbau in Dresden und bundesweit. Für Privat, Gewerbe und Industrie."
  path="/leistungen/"
  schema={[crumbSchema([['Leistungen', '/leistungen/']])]}
>
  <Breadcrumbs items={[['Leistungen']]} />
  <section class="hero small" style={heroStyle()}>
    <div class="wrap">
      <div>
        <span class="eyebrow">Leistungen</span>
        <h1>Präzision in Beton: unsere Leistungen</h1>
        <p class="lead">Professionelle Betonbearbeitung für private, gewerbliche und industrielle Projekte, mit moderner Technik, geschultem Fachpersonal und hohem Qualitätsanspruch.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cards">
        {leistungen.map((s) => (
          <a class="card" href={`/${s.slug}/`}>
            <div class="ico"><Icon name={s.icon} size={28} /></div>
            <h3>{s.name}</h3>
            <p>{s.intro.split('.')[0]}.</p>
            <span class="more">Mehr erfahren <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
      <h2 style="margin-top:3rem">Typische Anwendungen</h2>
      <div class="cards">
        {anwendungen.map((s) => (
          <a class="card" href={`/${s.slug}/`}>
            <div class="ico"><Icon name={s.icon} size={28} /></div>
            <h3>{s.name}</h3>
            <p>{s.intro.split('.')[0]}.</p>
            <span class="more">Mehr erfahren <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <div class="cards">
        <div class="card">
          <div class="ico"><Icon name="shield" size={28} /></div>
          <h3>Warum Kernbohr-Expert?</h3>
          <ul class="checks">
            {['Inhaber seit 2006 in der Baubranche, Kernbohr-Expert seit 2017', 'Zuverlässigkeit und Termintreue', 'Faire Preise und transparente Angebote', 'Modernes Equipment und Fachkompetenz', 'Persönliche, unverbindliche Beratung'].map((t) => <li><Icon name="check" size={18} /> {t}</li>)}
          </ul>
        </div>
        <div class="card">
          <div class="ico"><Icon name="building" size={28} /></div>
          <h3>Einsatzbereiche</h3>
          <ul class="checks">
            {['Neubau und Umbau', 'Altbausanierung', 'Industrieanlagen', 'Wohn- und Gewerbeobjekte', 'Öffentliche Einrichtungen'].map((t) => <li><Icon name="check" size={18} /> {t}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
