---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Gallery from '../../components/Gallery.astro';
import CtaBand from '../../components/CtaBand.astro';
import HeroPreload from '../../components/HeroPreload.astro';
import { projekte } from '../../data/projekte.js';
import { site } from '../../data/site.js';
import { items, heroStyle } from '../../lib/media.js';
import { crumbSchema, faqSchema, videoSchema } from '../../lib/schema.js';

export function getStaticPaths() {
  return projekte.filter((p) => p.slug).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const datum = p.datum ? new Date(p.datum).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }) : null;
const path = `/referenzen/${p.slug}/`;
const hero = p.heroFoto;
const faqs = p.faq;
const medien = items(p.videos).filter((m) => m.type === 'video');
const schema = [
  crumbSchema([['Referenzen', '/referenzen/'], [p.titel, path]]),
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: p.titel,
    description: p.kurz,
    datePublished: p.veroeffentlicht,
    dateModified: p.veroeffentlicht,
    inLanguage: 'de-DE',
    image: `${site.url}/images/${p.foto}-1600.webp`,
    author: { '@id': `${site.url}/#business` },
    publisher: { '@id': `${site.url}/#business` },
    mainEntityOfPage: `${site.url}${path}`,
  },
  faqSchema(faqs),
  ...medien.map((v) => videoSchema(v)),
];
---
<Base
  title={p.metaTitle}
  description={p.metaDesc}
  path={path}
  schema={schema}
>
  <Breadcrumbs items={[['Referenzen', '/referenzen/'], [p.titel]]} />
  <HeroPreload slot="head" id={hero} />
  <section class="hero small" style={heroStyle(hero)}>
    <div class="wrap">
      <div>
        <span class="eyebrow">Referenz</span>
        <h1>{p.h1}</h1>
        {datum && <p class="lead byline"><span class="pill pill-ok">Ausgeführt am {datum}</span></p>}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <article class="prose">
        <div class="callout"><strong>Kurz gesagt</strong>{p.kurzgesagt}</div>

        <h2>Eckdaten</h2>
        <div class="table-scroll" tabindex="0" role="group" aria-label="Eckdaten (seitlich scrollbar)">
          <table class="facts">
            <tbody>
              {p.eckdaten.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
            </tbody>
          </table>
        </div>

        <h2>Die Aufgabe</h2>
        <p>{p.aufgabe}</p>

        <h2>So sind wir vorgegangen</h2>
        <ul>
          {p.vorgehen.map(([k, v]) => <li><strong>{k}:</strong> {v}</li>)}
        </ul>

        <h2>{p.warumTitel}</h2>
        {p.warum.map((t) => <p set:html={t} />)}

        <h2>Häufige Fragen</h2>
        {faqs.map(([q, ans]) => (
          <details>
            <summary>{q}</summary>
            <p>{ans}</p>
          </details>
        ))}
      </article>
    </div>
  </section>

  {p.galerien.map((g) => <Gallery ids={g.ids} eyebrow={g.eyebrow} title={g.titel} dark={g.dark} />)}

  <CtaBand title="Ähnliches Vorhaben?" text="Senden Sie uns Bohrliste, Plan oder ein Foto der Baustelle. Sie erhalten kostenlos ein Angebot." />
</Base>
