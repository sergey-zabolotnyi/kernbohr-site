---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import AnfrageForm from '../components/AnfrageForm.astro';
import Prozess from '../components/Prozess.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site.js';
import { heroStyle } from '../lib/media.js';
import { crumbSchema } from '../lib/schema.js';
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich habe eine Anfrage. Foto der Baustelle sende ich gleich mit.')}`;
---
<Base
  title="Kontakt & Angebot anfragen | Kernbohr-Expert Dresden"
  description="Kontakt für Kernbohrung, Betonsägen und Wanddurchbruch in Dresden und bundesweit. Anruf, WhatsApp mit Foto oder E-Mail. Auch am Wochenende, kostenlose Beratung."
  path="/kontakt/"
  schema={[crumbSchema([['Kontakt', '/kontakt/']])]}
>
  <Breadcrumbs items={[['Kontakt']]} />
  <section class="hero small" style={heroStyle()}>
    <div class="wrap">
      <div>
        <span class="eyebrow">Kontakt</span>
        <h1>Angebot anfragen</h1>
        <p class="lead">Der schnellste Weg: Foto der Baustelle per WhatsApp senden. Wir beraten kostenlos und unverbindlich und melden uns mit einem konkreten Angebot.</p>
        <div class="btns">
          <a class="btn btn-wa" href={wa} rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp mit Foto</a>
          <a class="btn btn-main" href={`tel:${site.phoneTel}`}><Icon name="phone" size={20} /> {site.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <span class="eyebrow">Anfrage</span>
      <h2>Rückruf anfordern</h2>
      <p class="lead">Name und Nummer genügen. Wir rufen Sie zum Wunschzeitpunkt zurück.</p>
      <AnfrageForm />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cards">
        <div class="card">
          <div class="ico"><Icon name="phone" size={28} /></div>
          <h3>Telefon</h3>
          <p><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></p>
        </div>
        <div class="card">
          <div class="ico"><Icon name="mail" size={28} /></div>
          <h3>E-Mail</h3>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div class="card">
          <div class="ico"><Icon name="pin" size={28} /></div>
          <h3>Standort</h3>
          <p>{site.company}<br />{site.street}<br />{site.zip} {site.city}</p>
        </div>
        <div class="card">
          <div class="ico"><Icon name="clock" size={28} /></div>
          <h3>Erreichbarkeit</h3>
          <p>24 Stunden, 7 Tage die Woche erreichbar.<br />Einsätze auch abends, am Wochenende und an Feiertagen nach Absprache.</p>
        </div>
      </div>
      <div class="callout" style="margin-top:2rem">
        <strong>Tipp für ein schnelles Angebot</strong>
        Senden Sie ein Foto der Bohrstelle, den gewünschten Durchmesser und die ungefähre Wandstärke. Mehr dazu in unserer <a href="/ratgeber/checkliste-termin-vorbereitung/">Checkliste</a>.
      </div>
    </div>
  </section>
  <Prozess eyebrow="Ablauf" title="So geht es nach Ihrer Anfrage weiter" />
</Base>
