---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { articles } from '../../data/articles.js';
import { heroStyle } from '../../lib/media.js';
import { crumbSchema } from '../../lib/schema.js';
---
<Base
  title="Ratgeber Kernbohrung & Betonbearbeitung | Kernbohr-Expert Dresden"
  description="Praxiswissen zu Kernbohrung, Wanddurchbruch, Wärmepumpe und Terminvorbereitung: Ratgeber vom Fachbetrieb aus Dresden."
  path="/ratgeber/"
  schema={[crumbSchema([['Ratgeber', '/ratgeber/']])]}
>
  <Breadcrumbs items={[['Ratgeber']]} />
  <section class="hero small" style={heroStyle()}>
    <div class="wrap">
      <div>
        <span class="eyebrow">Ratgeber</span>
        <h1>Wissen rund um Kernbohrung und Betonbearbeitung</h1>
        <p class="lead">Praxisnahe Antworten vom Fachbetrieb: von der Statik über die Abdichtung bis zur Terminvorbereitung.</p>
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="cards">
        {articles.map((a) => (
          <a class="card" href={`/ratgeber/${a.slug}/`}>
            <div class="ico"><Icon name={a.icon} size={28} /></div>
            <h3>{a.title}</h3>
            <p>{a.short}</p>
            <span class="more">Lesen <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
