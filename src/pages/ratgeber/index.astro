---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import CardMedia from '../../components/CardMedia.astro';
import { artikelBild } from '../../data/kartenbild.js';
import { articles } from '../../data/articles.js';
import HeroPreload from '../../components/HeroPreload.astro';
import { heroStyle } from '../../lib/media.js';
import { crumbSchema } from '../../lib/schema.js';
---
<Base
  title="Ratgeber Kernbohrung & Betonbearbeitung"
  description="Praxiswissen zu Kernbohrung, Wanddurchbruch, Wärmepumpe und Terminvorbereitung: Ratgeber vom Fachbetrieb aus Dresden."
  path="/ratgeber/"
  schema={[crumbSchema([['Ratgeber', '/ratgeber/']])]}
>
  <Breadcrumbs items={[['Ratgeber']]} />
  <HeroPreload slot="head" id={'werk-oeffnung-schiene'} />
  <section class="hero small" style={heroStyle('werk-oeffnung-schiene')}>
    <div class="wrap">
      <div>
        <span class="eyebrow">Ratgeber</span>
        <h1>Wissen rund um Kernbohrung und Betonbearbeitung</h1>
        <p class="lead">Praxisnahe Antworten vom Fachbetrieb: von der Statik über die Abdichtung bis zur Terminvorbereitung.</p>
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="cards">
        {articles.map((a) => (
          <a class="card has-img" href={`/ratgeber/${a.slug}/`}>
            {artikelBild[a.slug] && <CardMedia id={artikelBild[a.slug]} />}
            <div class="card-body">
              <div class="ico"><Icon name={a.icon} size={24} /></div>
              <h3>{a.title}</h3>
              <p>{a.short}</p>
              <span class="more">Lesen <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
