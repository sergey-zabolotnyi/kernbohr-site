---
import Base from '../layouts/Base.astro';
import Rechner from '../components/Rechner.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import CardMedia from '../components/CardMedia.astro';
import { kartenbild } from '../data/kartenbild.js';
import Gallery from '../components/Gallery.astro';
import Prozess from '../components/Prozess.astro';
import { prozess } from '../data/prozess.js';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site.js';
import { services, faqs as allFaqs } from '../data/services.js';
import { articles } from '../data/articles.js';
import { orte } from '../data/orte.js';
import { image, heroStyle } from '../lib/media.js';
import { faqSchema, howToSchema } from '../lib/schema.js';

const pick = ['Was kostet eine Kernbohrung', 'Arbeiten Sie auch am Wochenende', 'Wie tief können Sie bohren', 'Wie groß können die Bohrdurchmesser', 'Arbeiten Sie staubfrei', 'In welchen Regionen'];
const faqs = pick.map((p) => allFaqs.find(([q]) => q.startsWith(p))).filter(Boolean);
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hallo, ich habe eine Anfrage für eine Kernbohrung. Foto der Baustelle sende ich gleich mit.')}`;
const leistungen = services.filter((s) => s.group === 'Leistung');
const anwendungen = services.filter((s) => s.group === 'Anwendung');
const hasPhoto = !!image('werk-wand-gross');

const werte = [
  ['hardhat', 'Fachkompetenz', 'Wir arbeiten präzise und professionell, mit moderner Technik.'],
  ['clock', 'Zuverlässigkeit', 'Wir halten Termine und Absprachen.'],
  ['shield', 'Saubere Arbeit', 'Wir verlassen Ihre Baustelle aufgeräumt.'],
  ['user', 'Erreichbarkeit', 'Telefon Mo–Sa 7–19 Uhr, Einsätze nach Absprache rund um die Uhr.'],
];
---
<Base
  title="Kernbohrung Dresden ab 1,20 €/cm | Kernbohr-Expert"
  description="Kernbohrung und Wanddurchbruch in Dresden und Sachsen: Ø 14–500 mm, bis 2 m tief, Preisliste ab 1,20 € je cm. Einsätze nach Absprache rund um die Uhr."
  path="/"
  schema={[faqSchema(faqs), howToSchema('Kernbohrung beauftragen und ausführen lassen', prozess.map((s) => [s.t, s.d]))]}
>
  {hasPhoto && <link slot="head" rel="preload" as="image" type="image/webp" imagesrcset={`/images/werk-wand-gross-800.webp 800w, /images/werk-wand-gross-1600.webp 1600w`} imagesizes="(max-width: 860px) 100vw, 60vw" fetchpriority="high" />}
  <section class={`hero ${hasPhoto ? 'has-bg' : 'no-photo'}`} style={heroStyle()}>
    {hasPhoto && <Photo id="werk-wand-gross" eager class="hero-bg" sizes="(max-width: 860px) 100vw, 60vw" />}
    <div class="wrap">
      <div>
        <span class="eyebrow">Kernbohr-Expert · Dresden</span>
        <h1>Kernbohrung &amp; Wanddurchbruch in Dresden und Sachsen</h1>
        <p class="lead">Präzise Kernbohrungen von Ø 14 bis 500 mm und bis 2 m Tiefe in Beton, Stahlbeton und Mauerwerk, mit Hilti-Profitechnik, staubarm und erschütterungsarm. Richtpreis in 30 Sekunden oder Foto per WhatsApp senden.</p>
        <div class="btns">
          <a class="btn btn-main" href="#kb-rechner"><Icon name="euro" size={20} /> Richtpreis berechnen</a>
          <a class="btn btn-wa" href={wa} rel="noopener"><Icon name="whatsapp" size={20} /> Foto senden</a>
        </div>
        <ul class="hero-points">
          <li><Icon name="calendar" size={18} /> Seit 2006 am Bau</li>
          <li><Icon name="shield" size={18} /> Mitglied der Handwerkskammer Dresden</li>
          <li><Icon name="map" size={18} /> Bundesweit im Einsatz</li>
        </ul>
      </div>
      
    </div>
  </section>

  <section class="strip-sec">
    <div class="wrap strip">
      <div><Icon name="drill" size={30} /><span>Ø 14–500 mm<small>bis 2 m Tiefe, auch über Kopf</small></span></div>
      <div><Icon name="drop" size={30} /><span>Staubarm<small>nass und mit Schutzmaßnahmen</small></span></div>
      <div><Icon name="home" size={30} /><span>Bewohnte Gebäude<small>lärm- und vibrationsarm</small></span></div>
      <div><Icon name="clock" size={30} /><span>Einsatz 24/7<small>nach Absprache, auch am Wochenende</small></span></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Leistungen</span>
      <h2>Was wir für Sie tun</h2>
      <p class="lead">Von der einzelnen Leitungsdurchführung bis zum Rückbau: Betonbearbeitung aus einer Hand.</p>
      <div class="cards">
        {leistungen.map((s) => (
          <a class="card has-img" href={`/${s.slug}/`}>
            {kartenbild[s.slug] && <CardMedia id={kartenbild[s.slug][0]} alt={kartenbild[s.slug][1]} />}
            <div class="card-body">
              <div class="ico"><Icon name={s.icon} size={24} /></div>
              <h3>{s.name}</h3>
              <p>{s.intro.split('.')[0]}.</p>
              <span class="more">Mehr erfahren <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <span class="eyebrow">Anwendungen</span>
      <h2>Typische Aufträge im Haus</h2>
      <div class="cards">
        {anwendungen.map((s) => (
          <a class="card has-img" href={`/${s.slug}/`}>
            {kartenbild[s.slug] && <CardMedia id={kartenbild[s.slug][0]} alt={kartenbild[s.slug][1]} />}
            <div class="card-body">
              <div class="ico"><Icon name={s.icon} size={24} /></div>
              <h3>{s.name}</h3>
              <p>{s.intro.split('.')[0]}.</p>
              <span class="more">Mehr erfahren <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Einsatzbereitschaft</span>
      <h2>Wir kommen auch, wenn andere Pause machen</h2>
      <p class="lead">Unsere Einsätze sind nach Absprache rund um die Uhr möglich: abends, nachts, am Wochenende und an Feiertagen, soweit Ruhezeiten und Hausordnung das zulassen. Telefonisch erreichen Sie uns Montag bis Samstag von 7 bis 19 Uhr. Für größere Projekte auch in anderen Bundesländern.</p>
      <div class="btns">
        <a class="btn btn-main" href="/kernbohrung-notdienst-wochenende/"><Icon name="clock" size={20} /> Einsatz am Wochenende</a>
        <a class="btn btn-wa" href={wa} rel="noopener"><Icon name="whatsapp" size={20} /> Foto senden</a>
      </div>
    </div>
  </section>

  <Gallery
    dark
    eyebrow="Einblick"
    title="So arbeiten wir"
    ids={['werk-bohrstaender', 'video-kernbohr-schiene', 'werk-ueberkopf-1', 'video-wandsaege', 'werk-wand-gross', 'video-fugenschneider']}
  />

  <section>
    <div class="wrap"><Rechner /></div>
  </section>

  <section class="soft">
    <div class="wrap">
      <span class="eyebrow">Unsere Werte</span>
      <h2>Wofür wir stehen</h2>
      <div class="cards">
        {werte.map(([icon, t, d]) => (
          <div class="card">
            <div class="ico"><Icon name={icon} size={28} /></div>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-home">
    <div class="wrap">
      <span class="eyebrow">Wer hinter Kernbohr-Expert steht</span>
      <h2>Ihr Ansprechpartner: {site.owner}</h2>
      <p class="lead">Ein Betrieb mit Gesicht und festem Standort in Dresden: Sie sprechen direkt mit dem Inhaber, nicht mit einer Vermittlungsplattform.</p>
      <dl class="about-facts">
        <div><dt>Inhaber</dt><dd>{site.owner}, in der Baubranche seit {site.sinceBranche}</dd></div>
        <div><dt>Unternehmen</dt><dd>{site.company}, gegründet {site.founded}</dd></div>
        <div><dt>Mitgliedschaft</dt><dd>Handwerkskammer Dresden</dd></div>
        <div><dt>Standort</dt><dd>{site.street}, {site.zip} {site.city}</dd></div>
        <div><dt>Technik</dt><dd>Hilti-Kernbohrtechnik, Wandsäge, Fugenschneider, Ortungsgerät, Wassersauger</dd></div>
        <div><dt>USt-IdNr.</dt><dd>{site.vatId}</dd></div>
      </dl>
      <p class="about-links">
        <a class="btn btn-line" href="/ueber-uns/">Mehr über uns</a>
        <a class="btn btn-line" href={site.googleMaps} target="_blank" rel="noopener">Wir auf Google Maps</a>
        <a class="btn btn-line" href={site.googleReview} target="_blank" rel="noopener">Bewertung auf Google schreiben</a>
      </p>
    </div>
  </section>

  <Prozess />

  <section class="soft">
    <div class="wrap">
      <span class="eyebrow">Ratgeber</span>
      <h2>Wissen für Ihr Bauvorhaben</h2>
      <div class="cards">
        {articles.slice(0, 3).map((a) => (
          <a class="card" href={`/ratgeber/${a.slug}/`}>
            <div class="ico"><Icon name={a.icon} size={28} /></div>
            <h3>{a.title}</h3>
            <p>{a.short}</p>
            <span class="more">Lesen <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Technische Daten</span>
      <h2>Auf einen Blick</h2>
      <div class="table-scroll">
        <table class="facts">
          <tbody>
            <tr><th>Durchmesser</th><td>14–500 mm, größere Durchmesser auf Anfrage</td></tr>
            <tr><th>Bohrtiefe</th><td>bis 2 m</td></tr>
            <tr><th>Technik</th><td>Hilti-Kernbohrtechnik auf Bohrständer oder Schiene</td></tr>
            <tr><th>Materialien</th><td>Beton, Stahlbeton, Ziegelmauerwerk, Naturstein</td></tr>
            <tr><th>Verfahren</th><td>Nass- und Trockenbohrung, horizontal, vertikal und über Kopf</td></tr>
            <tr><th>Strom</th><td>230 V oder 400 V (Adapter auf 16 A)</td></tr>
            <tr><th>Wasser</th><td>Normaler Wasseranschluss auf der Baustelle</td></tr>
            <tr><th>Einsatzgebiet</th><td>Dresden, Radebeul, Meißen, Pirna, Sachsen; bundesweit für größere Projekte</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="soft">
    <div class="wrap">
      <span class="eyebrow">FAQ</span>
      <h2>Häufige Fragen</h2>
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
      <div class="btns"><a class="btn btn-main" href="/faq/">Alle Fragen ansehen</a></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Einsatzgebiet</span>
      <h2>Dresden, Radebeul, Meißen, Pirna und ganz Sachsen</h2>
      <p class="lead">Unser Sitz ist Dresden. Für größere Projekte sind wir bundesweit im Einsatz.</p>
      <ul class="chips">
        {['Dresden', 'Coswig', 'Heidenau', 'Dippoldiswalde'].map((c) => <li>{c}</li>)}
        {orte.map((o) => <li><a href={`/kernbohrung-in-${o.slug}/`}>{o.name}</a></li>)}
      </ul>
      <a class="btn btn-line" href="/einsatzgebiet/">Zum Einsatzgebiet</a>
    </div>
  </section>

  <CtaBand />
</Base>
